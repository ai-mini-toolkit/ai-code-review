# 应用标题
VITE_APP_TITLE=AI Code Review

# 端口号
VITE_PORT=5173

VITE_BASE=/

# 接口地址
# 所有 API 路径已包含 /api/v1 前缀，baseURL 设为空避免路径重复
VITE_GLOB_API_URL=

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
# AI Code Review: 关闭 Mock，使用真实后端 API
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
